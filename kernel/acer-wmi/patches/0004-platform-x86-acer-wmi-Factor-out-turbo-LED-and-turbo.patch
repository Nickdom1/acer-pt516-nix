From 64c07bc70031a84e6be5d222e7bdd9a910e13f1a Mon Sep 17 00:00:00 2001
From: Nicholas DeTello <no-reply@detello.com>
Date: Tue, 6 Oct 2026 07:47:29 -0400
Subject: [PATCH 04/11] platform/x86: acer-wmi: Factor out turbo LED and turbo
 mode helpers

acer_toggle_turbo() open-codes reading the turbo LED, writing it with
magic values and switching the fans and overclocking settings in two
mirrored branches. Move these steps into acer_get_turbo_led(),
acer_set_turbo_led() and acer_set_turbo() so that the following patches
can change the LED encoding and reuse the turbo switch.
acer_set_turbo_led() returns an errno.

The values written are unchanged: 0x10001 (on) and 0x1 (off) become
ACER_GAMING_LED_TURBO with the state in bits 23:16.

No functional change intended.

Assisted-by: LLM
---
 drivers/platform/x86/acer-wmi.c | 83 +++++++++++++++++++--------------
 1 file changed, 48 insertions(+), 35 deletions(-)

diff --git a/drivers/platform/x86/acer-wmi.c b/drivers/platform/x86/acer-wmi.c
index c0443b9be..f5563568d 100644
--- a/drivers/platform/x86/acer-wmi.c
+++ b/drivers/platform/x86/acer-wmi.c
@@ -92,6 +92,9 @@ MODULE_LICENSE("GPL");
 #define ACER_GAMING_FAN_SPEED_ID_MASK GENMASK_ULL(7, 0)
 #define ACER_GAMING_FAN_SPEED_VALUE_MASK GENMASK_ULL(15, 8)
 
+#define ACER_GAMING_LED_TURBO		0x01
+#define ACER_GAMING_LED_SET_STATE_MASK	GENMASK_ULL(23, 16)
+
 #define ACER_GAMING_MISC_SETTING_STATUS_MASK GENMASK_ULL(7, 0)
 #define ACER_GAMING_MISC_SETTING_INDEX_MASK GENMASK_ULL(7, 0)
 #define ACER_GAMING_MISC_SETTING_VALUE_MASK GENMASK_ULL(15, 8)
@@ -2108,49 +2111,59 @@ static int acer_gsensor_event(void)
 	return 0;
 }
 
+static int acer_set_turbo_led(bool on)
+{
+	if (ACPI_FAILURE(WMID_gaming_set_u64(ACER_GAMING_LED_TURBO |
+					     FIELD_PREP(ACER_GAMING_LED_SET_STATE_MASK, on),
+					     ACER_CAP_TURBO_LED)))
+		return -EIO;
+
+	return 0;
+}
+
+static int acer_get_turbo_led(bool *on)
+{
+	u64 result;
+
+	if (ACPI_FAILURE(WMID_gaming_get_u64(&result, ACER_CAP_TURBO_LED)))
+		return -EIO;
+
+	*on = result;
+
+	return 0;
+}
+
+static void acer_set_turbo(bool on)
+{
+	acer_set_turbo_led(on);
+
+	if (has_cap(ACER_CAP_TURBO_FAN))
+		WMID_gaming_set_fan_mode(on ? ACER_WMID_FAN_MODE_TURBO :
+					      ACER_WMID_FAN_MODE_AUTO);
+
+	if (has_cap(ACER_CAP_TURBO_OC)) {
+		u8 oc = on ? ACER_WMID_OC_TURBO : ACER_WMID_OC_NORMAL;
+
+		WMID_gaming_set_misc_setting(ACER_WMID_MISC_SETTING_OC_1, oc);
+		WMID_gaming_set_misc_setting(ACER_WMID_MISC_SETTING_OC_2, oc);
+	}
+}
+
 /*
  *  Predator series turbo button
  */
 static int acer_toggle_turbo(void)
 {
-	u64 turbo_led_state;
-
-	/* Get current state from turbo button */
-	if (ACPI_FAILURE(WMID_gaming_get_u64(&turbo_led_state, ACER_CAP_TURBO_LED)))
-		return -1;
+	bool on;
+	int err;
 
-	if (turbo_led_state) {
-		/* Turn off turbo led */
-		WMID_gaming_set_u64(0x1, ACER_CAP_TURBO_LED);
+	err = acer_get_turbo_led(&on);
+	if (err)
+		return err;
 
-		/* Set FAN mode to auto */
-		if (has_cap(ACER_CAP_TURBO_FAN))
-			WMID_gaming_set_fan_mode(ACER_WMID_FAN_MODE_AUTO);
+	acer_set_turbo(!on);
 
-		/* Set OC to normal */
-		if (has_cap(ACER_CAP_TURBO_OC)) {
-			WMID_gaming_set_misc_setting(ACER_WMID_MISC_SETTING_OC_1,
-						     ACER_WMID_OC_NORMAL);
-			WMID_gaming_set_misc_setting(ACER_WMID_MISC_SETTING_OC_2,
-						     ACER_WMID_OC_NORMAL);
-		}
-	} else {
-		/* Turn on turbo led */
-		WMID_gaming_set_u64(0x10001, ACER_CAP_TURBO_LED);
-
-		/* Set FAN mode to turbo */
-		if (has_cap(ACER_CAP_TURBO_FAN))
-			WMID_gaming_set_fan_mode(ACER_WMID_FAN_MODE_TURBO);
-
-		/* Set OC to turbo mode */
-		if (has_cap(ACER_CAP_TURBO_OC)) {
-			WMID_gaming_set_misc_setting(ACER_WMID_MISC_SETTING_OC_1,
-						     ACER_WMID_OC_TURBO);
-			WMID_gaming_set_misc_setting(ACER_WMID_MISC_SETTING_OC_2,
-						     ACER_WMID_OC_TURBO);
-		}
-	}
-	return turbo_led_state;
+	return 0;
 }
 
 static int

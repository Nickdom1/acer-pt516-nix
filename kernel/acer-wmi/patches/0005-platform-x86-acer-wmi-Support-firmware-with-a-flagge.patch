From b4095cfbcb5fae27374ae0cf577b1fbb61a8602a Mon Sep 17 00:00:00 2001
From: Nicholas DeTello <no-reply@detello.com>
Date: Tue, 6 Oct 2026 07:47:29 -0400
Subject: [PATCH 05/11] platform/x86: acer-wmi: Support firmware with a flagged
 turbo LED state

On the Predator PT516-52s (BIOS V1.04), once its quirk enables the key,
every press of the Turbo key enables turbo mode again instead of
toggling it. The driver takes the current state from GetGamingLED, but
the firmware's SetGamingLED handler only accepts 0x10 (off) or 0x11 (on)
in byte 2 for the turbo LED (selector 1) and rejects the 0x00/0x01 the
driver sends, so the EC's turbo state (TKST) is never set and always
reads back 0:

  Local0 = DerefOf (BHGL [Zero])
  Local2 = DerefOf (BHGL [0x02])
  BHSK [Zero] = One
  ...
  If ((Local0 == One)) {
      If ((Local2 == 0x10)) { BHSK [Zero] = Zero; TKST = Zero }
      ElseIf ((Local2 == 0x11)) { BHSK [Zero] = Zero; TKST = One }
      Else { BHSK [Zero] = One }
  }

GetGamingLED returns {status, TKST & 3, ...}, so the state is in byte 1
and a non-zero byte 0 means the query failed. SetGamingLED returns the
same status byte, independently of the ACPI call itself succeeding.

Add a turbo_led_state_valid quirk for such firmware: set bit 4 of the
state byte when writing the LED, check the status byte the write
returns, and decode status and state when reading the LED back. The
status check lives in the LED helper; WMID_gaming_set_u64() only gains
a parameter that passes the result through. A rejected write is
reported with a warning while the fan mode is still switched. Models
without the quirk keep the existing encoding and response handling. Only
the PT516-52s (BIOS V1.04) is known to use this encoding.

Assisted-by: LLM
---
 drivers/platform/x86/acer-wmi.c | 49 ++++++++++++++++++++++++++++-----
 1 file changed, 42 insertions(+), 7 deletions(-)

diff --git a/drivers/platform/x86/acer-wmi.c b/drivers/platform/x86/acer-wmi.c
index f5563568d..0f512ab60 100644
--- a/drivers/platform/x86/acer-wmi.c
+++ b/drivers/platform/x86/acer-wmi.c
@@ -94,6 +94,9 @@ MODULE_LICENSE("GPL");
 
 #define ACER_GAMING_LED_TURBO		0x01
 #define ACER_GAMING_LED_SET_STATE_MASK	GENMASK_ULL(23, 16)
+#define ACER_GAMING_LED_SET_STATE_VALID	BIT(4)
+#define ACER_GAMING_LED_STATUS_MASK	GENMASK_ULL(7, 0)
+#define ACER_GAMING_LED_STATE_MASK	GENMASK_ULL(15, 8)
 
 #define ACER_GAMING_MISC_SETTING_STATUS_MASK GENMASK_ULL(7, 0)
 #define ACER_GAMING_MISC_SETTING_INDEX_MASK GENMASK_ULL(7, 0)
@@ -405,6 +408,7 @@ struct quirk_entry {
 	s8 brightness;
 	u8 bluetooth;
 	bool turbo;
+	bool turbo_led_state_valid;
 	u8 cpu_fans;
 	u8 gpu_fans;
 	bool hwmon;
@@ -1661,7 +1665,7 @@ static int WMI_gaming_execute_u32_u64(u32 method_id, u32 in, u64 *out)
 	return ret;
 }
 
-static acpi_status WMID_gaming_set_u64(u64 value, u32 cap)
+static acpi_status WMID_gaming_set_u64(u64 value, u32 cap, u64 *result)
 {
 	u32 method_id = 0;
 
@@ -1676,7 +1680,7 @@ static acpi_status WMID_gaming_set_u64(u64 value, u32 cap)
 		return AE_BAD_PARAMETER;
 	}
 
-	return WMI_gaming_execute_u64(method_id, value, NULL);
+	return WMI_gaming_execute_u64(method_id, value, result);
 }
 
 static acpi_status WMID_gaming_get_u64(u64 *value, u32 cap)
@@ -2111,11 +2115,33 @@ static int acer_gsensor_event(void)
 	return 0;
 }
 
+/*
+ * Most supported firmware takes the turbo LED state as 0/1 in byte 2 of the
+ * SetGamingLED input and reports it as a non-zero GetGamingLED result.
+ * Some firmware (PT516-52s, BIOS V1.04) only accepts 0x10 (off) / 0x11 (on)
+ * in byte 2 and returns {status, state} in the first two bytes of the result.
+ */
 static int acer_set_turbo_led(bool on)
 {
-	if (ACPI_FAILURE(WMID_gaming_set_u64(ACER_GAMING_LED_TURBO |
-					     FIELD_PREP(ACER_GAMING_LED_SET_STATE_MASK, on),
-					     ACER_CAP_TURBO_LED)))
+	bool valid = quirks->turbo_led_state_valid;
+	acpi_status status;
+	u8 state = on;
+	u64 result;
+
+	if (valid)
+		state |= ACER_GAMING_LED_SET_STATE_VALID;
+
+	status = WMID_gaming_set_u64(ACER_GAMING_LED_TURBO |
+				     FIELD_PREP(ACER_GAMING_LED_SET_STATE_MASK, state),
+				     ACER_CAP_TURBO_LED, valid ? &result : NULL);
+	if (ACPI_FAILURE(status))
+		return -EIO;
+
+	/*
+	 * This firmware returns a status byte; the reply of firmware using the
+	 * 0/1 encoding has not been verified and stays ignored.
+	 */
+	if (valid && FIELD_GET(ACER_GAMING_LED_STATUS_MASK, result))
 		return -EIO;
 
 	return 0;
@@ -2128,14 +2154,23 @@ static int acer_get_turbo_led(bool *on)
 	if (ACPI_FAILURE(WMID_gaming_get_u64(&result, ACER_CAP_TURBO_LED)))
 		return -EIO;
 
-	*on = result;
+	if (!quirks->turbo_led_state_valid) {
+		*on = result;
+		return 0;
+	}
+
+	if (FIELD_GET(ACER_GAMING_LED_STATUS_MASK, result))
+		return -EIO;
+
+	*on = FIELD_GET(ACER_GAMING_LED_STATE_MASK, result);
 
 	return 0;
 }
 
 static void acer_set_turbo(bool on)
 {
-	acer_set_turbo_led(on);
+	if (acer_set_turbo_led(on))
+		pr_warn("Failed to set the Turbo LED state\n");
 
 	if (has_cap(ACER_CAP_TURBO_FAN))
 		WMID_gaming_set_fan_mode(on ? ACER_WMID_FAN_MODE_TURBO :
-- 
